import time
from faster_whisper import  WhisperModel
import os

model = WhisperModel("base", device="cpu", compute_type="int8")
CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
SAMPLES_DIR = os.path.abspath(os.path.join(CURRENT_DIR, "..", "Samples"))

TEST_CASES = [
    {"group": "Noise", "file": "bucky_and_steve_at_the_stark_expo__captain_america_the_first_avenger.mp4_v1.mp4", "lang": "en"},
    {"group": "Noise", "file": "background_music.mp4", "lang": "en"}
]

def run_benchmark():
    for item in TEST_CASES:
        filepath = os.path.join(SAMPLES_DIR, item["group"], item["file"])
        print(f"\nĐang xử lý file [{item['group']}]: {item['file']}")
        
        # Kiểm tra file có tồn tại hay không trước khi chạy
        if not os.path.exists(filepath):
            print(f"Lỗi: Không tìm thấy file tại đường dẫn {filepath}")
            continue

        # --- TRƯỜNG HỢP 1: BẬT VAD ---
        print("   -> Đang chạy: BẬT VAD (vad_filter=True)...")
        
        segments_vad, _ = model.transcribe(filepath, word_timestamps=True, vad_filter=True)
        start_vad = time.time()
        text_vad = ""
        for segment in segments_vad:
            text_vad += segment.text + " "
        end_vad = time.time()
        print(f"   Thời gian (BẬT VAD) : {end_vad - start_vad:.2f} giây")
        print (f"scripts: {text_vad.strip()}")

        # --- TRƯỜNG HỢP 2: TẮT VAD ---
        print("   -> Đang chạy: TẮT VAD (vad_filter=False)...")
        
        segments_no_vad, _ = model.transcribe(filepath, word_timestamps=True, vad_filter=False)
        start_no_vad = time.time()
        text_no_vad = ""
        for segment in segments_no_vad:
            text_no_vad += segment.text + " "
        end_no_vad = time.time()
        print(f"   Thời gian (TẮT VAD) : {end_no_vad - start_no_vad:.2f} giây")
        print (f"scripts: {text_no_vad.strip()}")

if __name__ == "__main__":
    print("🚀 BẮT ĐẦU CHẠY THỰC NGHIỆM ĐÁNH GIÁ VAD...")
    run_benchmark()
    print("\n Hoàn tất kiểm thử!")